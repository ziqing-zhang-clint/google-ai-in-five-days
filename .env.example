# ==============================================================================
# NexusOps Enterprise Agent Configuration
# ==============================================================================

# Google Gemini API Key (Required for live LLM execution)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Default: Gemini 2.5 Pro for Orchestrator, Flash for sub-tasks)
NEXUS_FRONTIER_MODEL=gemini-2.5-pro
NEXUS_FAST_MODEL=gemini-2.5-flash

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# Session & Memory Persistence
DATABASE_URL=sqlite:///nexus_ops_sessions.db
MAX_SESSION_HISTORY_STEPS=10
CONTEXT_COMPACTION_THRESHOLD=8

# OpenTelemetry Settings
OTEL_SERVICE_NAME=nexus-enterprise-ops-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true

# Security & HITL Limits
MAX_AGENT_ITERATIONS=10
AUTO_REFUND_LIMIT_USD=100.0
HITL_MANDATORY_THRESHOLD_USD=250.0
